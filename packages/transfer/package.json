    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@askdaddy/crypto": "workspace:*",
    "@askdaddy/otp": "workspace:*",
    "@askdaddy/vault": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
