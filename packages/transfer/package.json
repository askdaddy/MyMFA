{
  "name": "@askdaddy/transfer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "导入导出格式解析器与生成器、格式探测器、本 App 明文容器读写，零平台依赖",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
