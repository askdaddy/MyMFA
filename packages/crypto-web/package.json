{
  "name": "@askdaddy/crypto-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web / Chrome 扩展端的加密 Provider：hash-wasm Argon2id + WebCrypto AES-256-GCM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cross": "vitest run src/__tests__/consistency.test.ts src/__tests__/compat-consistency.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@askdaddy/crypto": "workspace:*",
    "hash-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "argon2": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
