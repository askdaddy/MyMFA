# ===========================================================================
node_modules/
.pnpm-store/
.pnpm-debug.log*
dist/
build/
out/
*.tsbuildinfo
.turbo/
coverage/
.nyc_output/
*.lcov

# ===========================================================================
# React Native / Expo（apps/mobile）
# ===========================================================================
.expo/
.expo-shared/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/google-services.json
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/Podfile.lock
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/*.xcodeproj/xcuserdata/
apps/mobile/*.jks
apps/mobile/*.keystore

# Android 原生（argon2-jvm 等原生模块构建产物）
.gradle/
local.properties
*.apk
*.aab
*.ap_
*.dex

# iOS 原生（libsodium 等）
xcuserdata/
*.xcscmblueprint
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# ===========================================================================
# Chrome 扩展（apps/extension）
# ===========================================================================
apps/extension/.output/
apps/extension/.wxt/
apps/extension/dist-zip/
*.zip
*.crx
*.pem

# ===========================================================================
# Tauri（apps/desktop，后期阶段）
# ===========================================================================
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/WixTools/

# ===========================================================================
# 编辑器与系统
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~

# ===========================================================================
# 日志与临时文件
# ===========================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
tmp/
temp/
*.tmp
